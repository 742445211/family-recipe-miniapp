.select-sheet-root {
  position: fixed;
  inset: 0;
  z-index: 1000;
  pointer-events: none;
}

.select-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  transition: opacity 200ms cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: auto;
}

.select-sheet-mask.is-active {
  opacity: 1;
}

.select-sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: var(--color-surface);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  box-shadow: var(--shadow-overlay);
  transform: translateY(100%);
  transition: transform 250ms cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: auto;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.select-sheet-panel.is-active {
  transform: translateY(0);
}

.select-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-3) var(--space-2);
  border-bottom: 2rpx solid var(--color-border);
}

.select-sheet-title {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--color-text);
  line-height: var(--leading-tight);
}

.select-sheet-cancel {
  font-size: var(--text-sm);
  color: var(--color-primary);
  font-weight: 600;
  padding: var(--space-1) var(--space-2);
  line-height: var(--leading-normal);
}

.select-sheet-list {
  max-height: calc(70vh - 100rpx);
}

.select-sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  padding: var(--space-3);
  border-bottom: 2rpx solid var(--color-border-subtle);
  transition: background-color 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

.select-sheet-item:last-child {
  border-bottom: none;
}

.select-sheet-item.is-selected {
  background: var(--color-accent-soft);
}

.select-sheet-item-hover {
  background: var(--color-surface-secondary);
}

.select-sheet-item-main {
  flex: 1;
  min-width: 0;
}

.select-sheet-label {
  display: block;
  font-size: var(--text-base);
  font-weight: 500;
  color: var(--color-text);
  line-height: var(--leading-normal);
}

.select-sheet-subtitle {
  display: block;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: 4rpx;
  line-height: var(--leading-normal);
}

.select-sheet-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
  position: relative;
}

.select-sheet-check::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 10rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}

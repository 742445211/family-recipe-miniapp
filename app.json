{
  "_全局注释": "app.json - 小程序全局配置文件，定义页面路由、窗口样式、底部TabBar等",

  "pages": [
    "pages/index/index",
    "pages/recipe-detail/recipe-detail",
    "pages/recipe-edit/recipe-edit",
    "pages/order/order",
    "pages/mine/mine",
    "pages/family/family",
    "pages/family-join/family-join",
    "pages/ai-recommend/ai-recommend",
    "pages/notification-settings/notification-settings",
    "pages/login/login"
  ],
  "_pages注释": "pages - 页面路由数组，第一项为小程序首页。所有页面路径必须在此注册，否则无法跳转",

  "window": {
    "navigationBarBackgroundColor": "#FF6B35",
    "navigationBarTitleText": "家庭菜谱",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F5F5F5"
  },
  "_window注释": "window - 全局窗口样式配置。navigationBarBackgroundColor: 导航栏背景色(橙色); navigationBarTitleText: 默认标题; navigationBarTextStyle: 标题文字颜色(white/black); backgroundColor: 页面下拉背景色",

  "tabBar": {
    "color": "#999",
    "selectedColor": "#FF6B35",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "菜谱",
        "iconPath": "images/tab-recipe.png",
        "selectedIconPath": "images/tab-recipe-active.png"
      },
      {
        "pagePath": "pages/order/order",
        "text": "点菜",
        "iconPath": "images/tab-menu.png",
        "selectedIconPath": "images/tab-menu-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "images/tab-mine.png",
        "selectedIconPath": "images/tab-mine-active.png"
      }
    ]
  },
  "_tabBar注释": "tabBar - 底部标签栏配置。color: 未选中文字颜色; selectedColor: 选中文字颜色(橙色); list: 标签列表，最多5个。每个标签需指定 pagePath(页面路径)、text(显示文字)、iconPath(未选中图标)、selectedIconPath(选中图标)"
}

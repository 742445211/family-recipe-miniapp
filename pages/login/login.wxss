.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
}
.logo-area { text-align: center; margin-bottom: 100rpx; }
.logo { font-size: 120rpx; display: block; margin-bottom: 30rpx; }
.title { font-size: 48rpx; color: #fff; font-weight: bold; display: block; }
.subtitle { font-size: 28rpx; color: rgba(255,255,255,0.8); margin-top: 10rpx; display: block; }
.btn-login {
  width: 100%;
  background: #fff;
  color: #FF6B35;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  padding: 24rpx 0;
}

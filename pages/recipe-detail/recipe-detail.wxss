.cover {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #eee;
}
.name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.name { font-size: 38rpx; font-weight: bold; }
.actions { display: flex; gap: 16rpx; }
.action-btn { font-size: 40rpx; }
.tags { display: flex; gap: 10rpx; margin-top: 16rpx; flex-wrap: wrap; }
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #FF6B35;
}
.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.amount { color: #999; }
.step-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  align-items: flex-start;
}
.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FF6B35;
  color: #fff;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.bottom-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
}
.bottom-bar button { flex: 1; margin: 0; }

/* 备注栏 */
.note-bar {
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}
.note-bar input {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
}

.container { padding-bottom: 180rpx; }

/* 点菜弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}
.modal-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 12rpx; }
.modal-recipe { display: block; font-size: 28rpx; color: #FF6B35; text-align: center; margin-bottom: 30rpx; }
.form-group { margin-bottom: 24rpx; }
.label { font-size: 26rpx; color: #666; margin-bottom: 10rpx; display: block; }
.form-group input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 40rpx;
}
.meal-row { display: flex; gap: 12rpx; }
.meal-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 10rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.meal-item.active { background: #FF6B35; color: #fff; }
.modal-btns { display: flex; gap: 20rpx; margin-top: 30rpx; }
.modal-btns button { flex: 1; margin: 0; }

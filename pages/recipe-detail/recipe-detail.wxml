<view class="container">
  <image wx:if="{{recipe.cover_url}}" src="{{recipe.cover_url}}" class="cover" mode="aspectFill" />
  
  <view class="card">
    <view class="name-row">
      <text class="name">{{recipe.name}}</text>
      <view class="actions">
        <text class="action-btn" bindtap="toggleFavorite">{{isFav ? '❤️' : '🤍'}}</text>
        <text class="action-btn" bindtap="markCooked">🍳</text>
      </view>
    </view>
    <view class="tags">
      <text class="tag tag-category">{{recipe.category}}</text>
      <text class="tag tag-{{recipe.difficulty}}">{{recipe.difficulty === 'easy' ? '简单' : recipe.difficulty === 'hard' ? '困难' : '中等'}}</text>
      <text wx:if="{{recipe.cook_time}}">⏱ {{recipe.cook_time}}分钟</text>
      <text>👨‍🍳 做过 {{recipe.cook_count}} 次</text>
    </view>
  </view>

  <view class="card" wx:if="{{recipe.ingredients}}">
    <view class="section-title">🥬 食材</view>
    <view wx:for="{{ingredients}}" wx:key="index" class="ingredient-item">
      <text>{{item.name}}</text>
      <text class="amount" wx:if="{{item.amount}}">{{item.amount}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{recipe.seasonings}}">
    <view class="section-title">🧂 调料</view>
    <view wx:for="{{seasonings}}" wx:key="index" class="ingredient-item">
      <text>{{item.name}}</text>
      <text class="amount" wx:if="{{item.amount}}">{{item.amount}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{recipe.steps}}">
    <view class="section-title">📝 步骤</view>
    <view wx:for="{{steps}}" wx:key="index" class="step-item">
      <view class="step-num">{{index + 1}}</view>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{recipe.tips}}">
    <view class="section-title">💡 小贴士</view>
    <text>{{recipe.tips}}</text>
  </view>

  <view class="bottom-bar">
    <button class="btn-outline" bindtap="editRecipe">编辑</button>
    <button class="btn-primary" bindtap="showOrder">加入点菜</button>
  </view>

  <!-- 点菜弹窗 -->
  <view hidden="{{!showOrderModal}}" class="modal-mask" bindtap="hideOrderModal" catchtouchmove>
    <view class="modal" catchtap>
      <view class="modal-title">加入今日点菜</view>
      <text class="modal-recipe">{{recipe.name}}</text>
      
      <view class="form-group">
        <text class="label">餐次</text>
        <view class="meal-row">
          <view class="meal-item {{orderMeal === 'breakfast' ? 'active' : ''}}" bindtap="onOrderMealChange" data-val="breakfast">🌅 早餐</view>
          <view class="meal-item {{orderMeal === 'lunch' ? 'active' : ''}}" bindtap="onOrderMealChange" data-val="lunch">☀️ 午餐</view>
          <view class="meal-item {{orderMeal === 'dinner' ? 'active' : ''}}" bindtap="onOrderMealChange" data-val="dinner">🌙 晚餐</view>
        </view>
      </view>

      <view class="form-group">
        <text class="label">备注（选填）</text>
        <input value="{{orderNote}}" bindinput="onOrderNoteInput" placeholder="如：少辣、多放葱..." />
      </view>

      <view class="modal-btns">
        <button class="btn-outline" bindtap="hideOrderModal">取消</button>
        <button class="btn-primary" bindtap="confirmOrder">确定</button>
      </view>
    </view>
  </view>
</view>

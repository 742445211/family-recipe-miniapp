<view class="container notify-page">
  <view class="gradient-border">
    <view class="gradient-border-inner is-flush channel-card">
      <view class="section-title">微信订阅消息</view>
      <text class="hint">个人小程序仅支持一次性订阅，每授权一次可用于一次点菜提醒。</text>
      <button class="btn-primary btn-block channel-btn" hover-class="btn-hover" bindtap="requestSubscribe">开启下一次微信提醒</button>
    </view>
  </view>

  <view class="gradient-border">
    <view class="gradient-border-inner is-flush channel-card">
      <view class="section-title">企业微信</view>
      <text class="hint">填写企业微信成员 UserID。</text>
      <view class="channel-form">
        <input class="channel-input" placeholder="企业微信 UserID" value="{{wecomUserid}}" bindinput="onWecomInput" />
        <button class="btn-primary btn-block channel-btn" hover-class="btn-hover" bindtap="saveWecom">保存</button>
      </view>
    </view>
  </view>

  <view class="gradient-border">
    <view class="gradient-border-inner is-flush channel-card">
      <view class="section-title">Server酱</view>
      <view class="channel-form">
        <input class="channel-input" placeholder="SendKey (SCT...)" value="{{serverChanKey}}" bindinput="onServerChanInput" />
        <button class="btn-primary btn-block channel-btn" hover-class="btn-hover" bindtap="saveServerChan">保存</button>
      </view>
    </view>
  </view>

  <view class="gradient-border">
    <view class="gradient-border-inner is-flush channel-card">
      <view class="section-title">Bark (iOS)</view>
      <view class="channel-form">
        <input class="channel-input" placeholder="Device Key" value="{{barkKey}}" bindinput="onBarkKeyInput" />
        <button class="btn-primary btn-block channel-btn" hover-class="btn-hover" bindtap="saveBark">保存</button>
      </view>
    </view>
  </view>

  <view class="gradient-border">
    <view class="gradient-border-inner is-flush channel-card">
      <view class="section-title">ntfy</view>
      <view class="channel-form">
        <input class="channel-input" placeholder="Topic" value="{{ntfyTopic}}" bindinput="onNtfyTopicInput" />
        <button class="btn-primary btn-block channel-btn" hover-class="btn-hover" bindtap="saveNtfy">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{channels.length}}" class="gradient-border">
    <view class="gradient-border-inner is-flush channel-card">
      <view class="section-title">已配置通道</view>
      <view wx:for="{{channels}}" wx:key="id" class="channel-item">
        <text class="channel-label">{{item.channel}} - {{item.masked_target || '已配置'}}</text>
        <text class="del" bindtap="deleteChannel" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>
</view>

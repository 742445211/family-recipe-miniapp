.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 12rpx; color: #333; }
.hint { font-size: 24rpx; color: #999; display: block; margin-bottom: 16rpx; line-height: 1.5; }
.input {
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  background: #fafafa;
}
.btn-primary { margin-top: 8rpx; }
.channel-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
}
.del { color: #F44336; padding: 8rpx; }

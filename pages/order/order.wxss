.date-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.date-str { font-size: 34rpx; font-weight: bold; color: #FF6B35; }
.date-nav { font-size: 28rpx; padding: 10rpx 20rpx; background: #fff; border-radius: 8rpx; }
.order-item { display: flex; align-items: center; padding: 16rpx; gap: 16rpx; }
.item-img { width: 100rpx; height: 100rpx; border-radius: 12rpx; background: #eee; }
.item-info { flex: 1; }
.item-name { font-size: 30rpx; font-weight: bold; display: block; }
.item-meta { color: #999; font-size: 24rpx; }
.item-adder { color: #999; font-size: 22rpx; margin-top: 4rpx; }
.del-btn { color: #F44336; font-size: 36rpx; padding: 10rpx; }

.date-bar-wrap {
  margin-bottom: var(--space-3);
}

.date-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  margin-bottom: 0;
}

.date-str {
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-primary);
}

.date-nav {
  font-size: var(--text-sm);
  padding: 12rpx var(--space-2);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  color: var(--color-primary);
  font-weight: 600;
  line-height: var(--leading-normal);
}

.share-btn {
  font-size: var(--text-xs) !important;
  padding: 10rpx var(--space-3) !important;
  background: var(--color-primary) !important;
  color: #fff !important;
  border-radius: var(--radius-full) !important;
  line-height: var(--leading-normal) !important;
  margin: 0;
  box-shadow: var(--shadow-soft) !important;
}

.share-btn::after {
  border: none;
}

.notify-wrap {
  margin-bottom: var(--space-3);
}

.notify-bar {
  padding: var(--space-2) var(--space-3);
  margin-bottom: 0;
  background: linear-gradient(135deg, #FFF8F0, #FFE8D6);
}

.notify-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-1);
}

.notify-badge {
  background: var(--color-primary);
  color: #fff;
  font-size: var(--text-xs);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  min-width: 36rpx;
  text-align: center;
  font-weight: 700;
  line-height: var(--leading-normal);
}

.notify-title {
  font-size: var(--text-base);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-primary);
}

.notify-item {
  padding: 10rpx 0;
  border-top: 2rpx solid var(--color-border);
}

.notify-content {
  font-size: var(--text-sm);
  line-height: var(--leading-relaxed);
  color: var(--color-text-secondary);
}

.meal-tabs {
  margin-bottom: var(--space-3);
}

.order-wrap {
  margin-bottom: var(--space-2);
}

.order-item {
  display: flex;
  align-items: center;
  padding: var(--space-2) var(--space-2);
  margin-bottom: 0;
  gap: var(--space-2);
}

.item-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--radius-md);
  background: #FFE8D6;
  flex-shrink: 0;
}

.item-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--color-primary);
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--text-md);
  font-weight: 700;
  line-height: var(--leading-tight);
  display: block;
  color: var(--color-text);
}

.item-meta {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  line-height: var(--leading-normal);
  display: block;
  margin-top: 4rpx;
}

.item-note {
  color: var(--color-primary);
  font-size: var(--text-xs);
  line-height: var(--leading-normal);
  margin-top: 6rpx;
  display: block;
}

.item-adder {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.adder-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}

.adder-placeholder {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--gradient-warm);
  color: #fff;
  font-size: var(--text-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.adder-name {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  line-height: var(--leading-normal);
}

.del-btn {
  color: var(--color-danger);
  font-size: var(--text-2xl);
  padding: 10rpx var(--space-2);
  line-height: 1;
  font-weight: 300;
}

.notify-bar {
  background: #fff7f0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #ffd4c2;
}
.notify-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.notify-badge {
  background: #FF6B35;
  color: #fff;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}
.notify-title { font-size: 26rpx; font-weight: bold; color: #FF6B35; }
.notify-item { padding: 8rpx 0; border-top: 1rpx solid #ffe8dc; }
.notify-content { font-size: 24rpx; color: #666; }

.date-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.date-str { font-size: 34rpx; font-weight: bold; color: #FF6B35; }
.date-nav { font-size: 28rpx; padding: 10rpx 20rpx; background: #fff; border-radius: 8rpx; }
.float-btn { opacity: 1; }

.meal-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}
.meal-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.meal-tab.active { background: #FF6B35; color: #fff; }
.order-item { display: flex; align-items: center; padding: 16rpx; gap: 16rpx; }
.item-img { width: 100rpx; height: 100rpx; border-radius: 12rpx; background: #eee; }
.item-info { flex: 1; }
.item-name { font-size: 30rpx; font-weight: bold; display: block; }
.item-meta { color: #999; font-size: 24rpx; display: block; }
.item-note { color: #FF6B35; font-size: 24rpx; margin-top: 4rpx; display: block; }
.item-adder { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; }
.adder-avatar { width: 40rpx; height: 40rpx; border-radius: 50%; }
.adder-placeholder { font-size: 28rpx; }
.adder-name { color: #999; font-size: 22rpx; }
.del-btn { color: #F44336; font-size: 36rpx; padding: 10rpx; }

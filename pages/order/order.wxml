<view class="container page-with-fab">
  <!-- 日期选择 -->
  <view class="gradient-border date-bar-wrap">
    <view class="gradient-border-inner date-bar">
      <text class="date-nav" bindtap="prevDay">◀</text>
      <text class="date-str">{{dateStr}}</text>
      <text class="date-nav" bindtap="nextDay">▶</text>
      <button class="share-btn" hover-class="btn-hover" open-type="share">分享</button>
    </view>
  </view>

  <!-- 未读通知 -->
  <view wx:if="{{unreadCount > 0}}" class="gradient-border notify-wrap">
    <view class="gradient-border-inner notify-bar">
      <view class="notify-header">
        <text class="notify-badge">{{unreadCount}}</text>
        <text class="notify-title">家人点菜了</text>
      </view>
      <view wx:for="{{unreadNotifications}}" wx:key="id" class="notify-item"
        bindtap="onNotificationTap" data-id="{{item.id}}" data-date="{{item.order_date}}" data-meal="{{item.meal_type}}">
        <text class="notify-content">{{item.content}}</text>
      </view>
    </view>
  </view>

  <!-- 餐次切换 -->
  <view class="segment-bar meal-tabs">
    <view wx:for="{{meals}}" wx:key="key" class="segment-item {{mealType === item.key ? 'active' : ''}}" bindtap="switchMeal" data-val="{{item.key}}">
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{blindBoxEnabled}}" class="gradient-border blind-box-entry-wrap" bindtap="openBlindBox" hover-class="blind-box-entry-hover">
    <view class="gradient-border-inner blind-box-entry">
      <text class="blind-box-icon">🎁</text>
      <view class="blind-box-text">
        <text class="blind-box-title">不知道吃什么？</text>
        <text class="blind-box-sub">从家庭菜谱里随机来一道</text>
      </view>
      <text class="blind-box-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{!orders.length}}" class="empty">
    <text class="empty-title">今天还没点菜</text>
    <text>去菜谱页挑几道吧</text>
  </view>

  <view wx:for="{{orders}}" wx:key="id" class="gradient-border order-wrap">
    <view class="gradient-border-inner order-item">
      <image wx:if="{{item.recipe.cover_url}}" src="{{item.recipe.cover_url}}" class="item-img" mode="aspectFill" lazy-load="{{true}}" />
      <view wx:else class="item-img item-img-placeholder">菜</view>
      <view class="item-info">
        <text class="item-name">{{item.recipe.name}}</text>
        <text class="item-meta">
          {{item.quantity}}份
          <text wx:if="{{item.meal_type}}"> · {{item.meal_type === 'breakfast' ? '早餐' : item.meal_type === 'lunch' ? '午餐' : '晚餐'}}</text>
        </text>
        <text class="item-note" wx:if="{{item.note}}">备注：{{item.note}}</text>
        <view class="item-adder" wx:if="{{item.adder}}">
          <image wx:if="{{item.adder.avatar_url}}" src="{{item.adder.avatar_url}}" class="adder-avatar" mode="aspectFill" lazy-load="{{true}}" />
          <view wx:else class="adder-placeholder">{{item.adder.nickname ? item.adder.nickname[0] : '?'}}</view>
          <text class="adder-name">{{item.adder.nickname || '匿名'}} 点的</text>
        </view>
      </view>
      <text class="del-btn" bindtap="removeOrder" data-id="{{item.id}}">×</text>
    </view>
  </view>

  <view
    class="float-btn-wrap"
    bindtap="addRecipe"
    hover-class="float-btn-wrap-hover"
    hover-stay-time="80"
    aria-label="去加菜"
  >
    <view class="float-btn">
      <view class="float-btn-icon" aria-hidden="true"></view>
    </view>
  </view>

  <!-- 点菜盲盒 -->
  <view wx:if="{{showBlindBox}}" class="modal-mask" bindtap="closeBlindBox" catchtouchmove>
    <view class="modal blind-box-modal" catchtap>
      <view class="modal-title">🎁 点菜盲盒</view>
      <text class="blind-box-date">{{dateStr}} · {{blindBoxMeal === 'breakfast' ? '早餐' : blindBoxMeal === 'lunch' ? '午餐' : '晚餐'}}</text>

      <view class="blind-box-stage">
        <view wx:if="{{blindBoxLoading}}" class="blind-box-shake">
          <text class="blind-box-box">🎲</text>
          <text class="blind-box-hint">正在抽取...</text>
        </view>
        <view wx:elif="{{blindBoxRecipe}}" class="blind-box-result">
          <image wx:if="{{blindBoxRecipe.cover_url}}" src="{{blindBoxRecipe.cover_url}}" class="blind-box-cover" mode="aspectFill" />
          <view wx:else class="blind-box-cover blind-box-cover-placeholder">菜</view>
          <text class="blind-box-name">{{blindBoxRecipe.name}}</text>
          <text class="blind-box-meta">{{blindBoxRecipe.category || '家常菜'}} · 还有 {{blindBoxPoolSize}} 道可选</text>
        </view>
      </view>

      <view wx:if="{{!mealType}}" class="form-group">
        <text class="label">加入餐次</text>
        <view class="segment-bar meal-row">
          <view class="segment-item {{blindBoxMeal === 'breakfast' ? 'active' : ''}}" bindtap="onBlindBoxMealChange" data-val="breakfast">早餐</view>
          <view class="segment-item {{blindBoxMeal === 'lunch' ? 'active' : ''}}" bindtap="onBlindBoxMealChange" data-val="lunch">午餐</view>
          <view class="segment-item {{blindBoxMeal === 'dinner' ? 'active' : ''}}" bindtap="onBlindBoxMealChange" data-val="dinner">晚餐</view>
        </view>
      </view>

      <view class="modal-btns blind-box-btns">
        <button class="btn-outline" hover-class="btn-hover" bindtap="closeBlindBox">取消</button>
        <button class="btn-outline" hover-class="btn-hover" bindtap="redrawBlindBox" disabled="{{blindBoxLoading || !blindBoxRecipe}}">换一个</button>
        <button class="btn-outline" hover-class="btn-hover" bindtap="goBlindBoxDetail" disabled="{{!blindBoxRecipe}}">详情</button>
        <button class="btn-primary" hover-class="btn-hover" bindtap="confirmBlindBoxOrder" disabled="{{!blindBoxRecipe}}">就选这道</button>
      </view>
    </view>
  </view>
</view>

<view class="container">
  <view class="card">
    <view class="header-row">
      <text class="name">{{menu.name}}</text>
      <text class="status status-{{menu.status}}">{{statusText}}</text>
    </view>
    <text class="date">📅 {{menu.date}}</text>
  </view>

  <view class="card">
    <view class="section-title">已点菜品 ({{menu.items ? menu.items.length : 0}})</view>
    <view wx:if="{{!menu.items || menu.items.length === 0}}" class="empty">还没点菜，快去加吧~</view>
    <view wx:for="{{menu.items}}" wx:key="id" class="item-row">
      <image wx:if="{{item.recipe && item.recipe.cover_url}}" src="{{item.recipe.cover_url}}" class="item-img" mode="aspectFill" />
      <view class="item-info">
        <text class="item-name">{{item.recipe ? item.recipe.name : '未知菜谱'}}</text>
        <text class="item-meta">{{item.quantity}}份 {{item.note}}</text>
      </view>
      <text wx:if="{{menu.status !== 'confirmed'}}" class="del" bindtap="removeItem" data-id="{{item.id}}">✕</text>
    </view>
  </view>

  <view class="bottom-actions" wx:if="{{menu.status !== 'confirmed'}}">
    <button class="btn-outline" bindtap="addRecipe">+ 添加菜品</button>
    <button class="btn-primary" bindtap="confirmMenu">确认菜单</button>
  </view>
</view>

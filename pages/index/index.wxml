<view class="page-index page-with-fab">
  <!-- 收藏模式标题栏 -->
  <view wx:if="{{mode === 'favorites'}}" class="fav-header gradient-border">
    <view class="gradient-border-inner fav-header-inner">
      <text class="fav-back" bindtap="backToRecipes">← 回去逛菜</text>
      <text class="fav-title">我的收藏</text>
      <text class="fav-placeholder"></text>
    </view>
  </view>

  <!-- 工具栏（菜谱模式） -->
  <view wx:if="{{mode === 'recipes'}}" class="toolbar">
    <view class="search-wrap">
      <input
        class="search-input"
        placeholder="搜搜今天想吃什么..."
        bindinput="onSearch"
        value="{{keyword}}"
      />
    </view>
    <view class="toolbar-row">
      <view
        class="select-trigger category-trigger {{categorySheetVisible ? 'is-open' : ''}}"
        bindtap="openCategorySheet"
        hover-class="select-trigger-hover"
        hover-stay-time="80"
      >
        <text class="select-trigger-text">{{categoryIndex >= 0 ? categories[categoryIndex] : '全部分类'}}</text>
        <view class="select-trigger-chevron"></view>
      </view>
    </view>
  </view>

  <!-- 加载 / 错误 / 空状态 -->
  <view wx:if="{{loading && !recipes.length}}" class="empty">
    <text class="empty-title">锅还没热...</text>
    <text>正在捞菜谱</text>
  </view>
  <view wx:elif="{{loadError && !recipes.length}}" class="empty">
    <text class="empty-title">网络开小差了</text>
    <text>下拉刷新，厨师马上到</text>
  </view>
  <view wx:elif="{{!recipes.length}}" class="empty">
    <text class="empty-title">{{mode === 'favorites' ? '收藏夹空空如也' : '厨房还缺一道菜'}}</text>
    <text>{{mode === 'favorites' ? '看到喜欢的，记得点个小爱心~' : '点右下角 + ，添第一道菜吧！'}}</text>
  </view>

  <!-- 单列信息流 -->
  <view wx:else class="feed-list">
    <view
      wx:for="{{recipes}}"
      wx:key="id"
      class="feed-card"
      bindtap="toDetail"
      data-id="{{item.id}}"
      hover-class="feed-card-press"
      hover-stay-time="80"
    >
      <view class="feed-cover-wrap">
        <image
          wx:if="{{item.cover_url}}"
          src="{{item.cover_url}}"
          class="feed-cover"
          mode="aspectFill"
          lazy-load="{{true}}"
        />
        <view wx:else class="feed-cover feed-cover-placeholder">
          <text class="feed-cover-placeholder-text">{{item.name}}</text>
        </view>
      </view>
      <view class="feed-body">
        <view class="feed-title">{{item.name}}</view>
        <view class="feed-meta-row">
          <view class="feed-difficulty">
            <text class="feed-meta-label">难度</text>
            <view class="feed-stars">
              <text
                wx:for="{{item.starList}}"
                wx:for-item="star"
                wx:for-index="si"
                wx:key="si"
                class="feed-star {{star.filled ? 'is-filled' : ''}}"
              >★</text>
            </view>
          </view>
          <view class="feed-likes">
            <view class="feed-icon-thumb" aria-hidden="true"></view>
            <text class="feed-likes-count">{{item.cook_count || 0}}</text>
          </view>
        </view>
        <view wx:if="{{item.cook_time}}" class="feed-meta-sub">
          <view class="feed-icon-time" aria-hidden="true"></view>
          <text>{{item.cook_time}} 分钟</text>
        </view>
        <view wx:if="{{item.summary}}" class="feed-desc">{{item.summary}}</view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="feed-footer">
      <text class="feed-footer-text">正在加载...</text>
    </view>
    <view wx:elif="{{!hasMore && recipes.length}}" class="feed-footer">
      <text class="feed-footer-text">已经到底啦</text>
    </view>
  </view>

  <!-- 浮动添加按钮（菜谱模式） -->
  <view
    wx:if="{{mode === 'recipes'}}"
    class="float-btn-wrap"
    bindtap="addRecipe"
    hover-class="float-btn-wrap-hover"
    hover-stay-time="80"
    aria-label="添加菜谱"
  >
    <view class="float-btn">
      <view class="float-btn-icon" aria-hidden="true"></view>
    </view>
  </view>

  <select-sheet
    visible="{{categorySheetVisible}}"
    title="选择分类"
    options="{{categoryOptions}}"
    value="{{category}}"
    bind:close="closeCategorySheet"
    bind:select="onCategorySelect"
  />
</view>

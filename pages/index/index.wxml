<view class="container">
  <!-- 收藏模式标题栏 -->
  <view wx:if="{{mode === 'favorites'}}" class="fav-header">
    <text class="fav-back" bindtap="backToRecipes">← 返回菜谱</text>
    <text class="fav-title">❤️ 我的收藏</text>
    <text class="fav-placeholder"></text>
  </view>

  <!-- 搜索栏（菜谱模式） -->
  <view wx:if="{{mode === 'recipes'}}" class="search-bar">
    <input placeholder="搜索菜谱..." bindinput="onSearch" value="{{keyword}}" />
    <picker bindchange="onCategory" value="{{categoryIndex}}" range="{{categories}}">
      <view class="category-picker">{{categories[categoryIndex] || '分类'}}</view>
    </picker>
  </view>

  <!-- 菜谱列表 -->
  <view wx:if="{{loading && !recipes.length}}" class="empty">加载中...</view>
  <view wx:elif="{{loadError && !recipes.length}}" class="empty">加载失败，请下拉刷新重试</view>
  <view wx:elif="{{!recipes.length}}" class="empty">
    {{mode === 'favorites' ? '还没有收藏哦~' : '暂无菜谱，快去添加吧~'}}
  </view>
  <view wx:for="{{recipes}}" wx:key="id" class="card recipe-card" bindtap="toDetail" data-id="{{item.id}}">
    <image
      wx:if="{{item.cover_url}}"
      src="{{item.cover_url}}"
      class="recipe-img"
      mode="aspectFill"
      lazy-load="{{true}}"
    />
    <view class="recipe-info">
      <view class="recipe-name">{{item.name}}</view>
      <view class="recipe-tags">
        <text class="tag tag-category">{{item.category}}</text>
        <text class="tag tag-{{item.difficulty}}">{{item.difficulty === 'easy' ? '简单' : item.difficulty === 'hard' ? '困难' : '中等'}}</text>
        <text wx:if="{{item.cook_time}}">{{item.cook_time}}分钟</text>
      </view>
    </view>
  </view>

  <!-- 浮动添加按钮（菜谱模式） -->
  <view wx:if="{{mode === 'recipes'}}" class="float-btn" bindtap="addRecipe">+</view>
</view>

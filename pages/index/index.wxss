.page-index {
  padding: var(--space-3) var(--space-3) 0;
  min-height: 100vh;
  box-sizing: border-box;
}

.toolbar {
  margin-bottom: var(--space-3);
}

.search-wrap {
  margin-bottom: var(--space-2);
}

.toolbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.category-chip {
  background: var(--color-accent-soft);
  border-radius: var(--radius-full);
  padding: 14rpx var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-primary-dark);
  font-weight: 600;
  line-height: var(--leading-normal);
  box-shadow: none;
  border: none;
}

.waterfall {
  column-count: 2;
  column-gap: var(--space-2);
}

.waterfall-item {
  break-inside: avoid;
  margin-bottom: var(--space-2);
  display: inline-block;
  width: 100%;
}

.waterfall-card {
  padding: 0;
  overflow: hidden;
}

.waterfall-img {
  width: 100%;
  display: block;
  background: #FFE8D6;
  min-height: 160rpx;
}

.waterfall-img-placeholder {
  width: 100%;
  height: 180rpx;
  background: linear-gradient(135deg, #FFE8D6, #FFD4A8);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  font-size: var(--text-xs);
}

.waterfall-info {
  padding: 10rpx 12rpx 12rpx;
}

.waterfall-name {
  font-size: var(--text-sm);
  font-weight: 700;
  line-height: var(--leading-tight);
  margin-bottom: 6rpx;
  color: var(--color-text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.waterfall-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx;
  min-height: 32rpx;
}

.meta-dot {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: 1;
}

.recipe-name {
  font-size: var(--text-base);
  font-weight: 700;
  line-height: var(--leading-tight);
  margin-bottom: var(--space-1);
  color: var(--color-text);
}

.recipe-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx;
}

.list-view {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.list-item-wrap {
  margin-bottom: 0;
}

.recipe-card {
  display: flex;
  align-items: center;
  padding: var(--space-2);
  margin-bottom: 0;
}

.recipe-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
  margin-right: var(--space-2);
  background: #FFE8D6;
  flex-shrink: 0;
}

.recipe-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--color-primary);
  background: linear-gradient(135deg, #FFE8D6, #FFD4A8);
}

.recipe-info {
  flex: 1;
  min-width: 0;
}

.list-view .recipe-name {
  font-size: var(--text-lg);
}

.cook-time-inline {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.fav-header {
  margin-bottom: var(--space-3);
}

.fav-header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-3);
  margin-bottom: 0;
}

.fav-back {
  font-size: var(--text-sm);
  color: var(--color-primary);
  font-weight: 600;
  line-height: var(--leading-normal);
}

.fav-title {
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.fav-placeholder {
  width: 120rpx;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.search-bar input {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}
.category-picker {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  min-width: 100rpx;
  text-align: center;
}
.recipe-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
}
.recipe-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #eee;
}
.recipe-info { flex: 1; }
.recipe-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.recipe-tags { display: flex; align-items: center; gap: 8rpx; }

.page-index {
  padding: var(--space-3) var(--space-3) 0;
  min-height: 100vh;
  box-sizing: border-box;
}

.toolbar {
  margin-bottom: var(--space-3);
}

.search-wrap {
  margin-bottom: var(--space-2);
}

.toolbar-row {
  display: flex;
  align-items: center;
}

.category-trigger {
  flex: 1;
  min-width: 0;
  border-radius: var(--radius-full);
  min-height: 72rpx;
  padding: 12rpx var(--space-3);
}

/* ===== 单列信息流 ===== */
.feed-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.feed-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow:
    0 2rpx 8rpx rgba(45, 24, 16, 0.04),
    0 8rpx 32rpx rgba(45, 24, 16, 0.06);
  transition: transform var(--duration-fast) var(--ease-smooth),
    box-shadow var(--duration-normal) var(--ease-smooth);
}

.feed-card-press {
  transform: scale(0.985);
  box-shadow:
    0 2rpx 6rpx rgba(45, 24, 16, 0.03),
    0 4rpx 16rpx rgba(45, 24, 16, 0.05);
}

.feed-cover-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: linear-gradient(145deg, #FFE8D6 0%, #FFD4A8 100%);
  overflow: hidden;
}

.feed-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.feed-cover-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-3);
  box-sizing: border-box;
}

.feed-cover-placeholder-text {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--color-primary);
  text-align: center;
  line-height: var(--leading-tight);
  opacity: 0.85;
}

.feed-body {
  padding: var(--space-3) var(--space-3) var(--space-4);
}

.feed-title {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.feed-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-1);
}

.feed-difficulty {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.feed-meta-label {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1;
  flex-shrink: 0;
}

.feed-stars {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.feed-star {
  font-size: 26rpx;
  line-height: 1;
  color: var(--color-surface-tertiary);
}

.feed-star.is-filled {
  color: var(--color-secondary);
}

.feed-likes {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  background: var(--color-surface-secondary);
  border-radius: var(--radius-full);
}

.feed-likes-count {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1;
  font-weight: 500;
}

.feed-icon-thumb {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  flex-shrink: 0;
}

.feed-icon-thumb::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid var(--color-text-muted);
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  transform: rotate(-12deg);
  box-sizing: border-box;
}

.feed-icon-thumb::after {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 14rpx;
  width: 8rpx;
  height: 12rpx;
  background: var(--color-text-muted);
  border-radius: 2rpx;
  transform: rotate(-28deg);
}

.feed-meta-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1;
}

.feed-icon-time {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--color-text-muted);
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
  flex-shrink: 0;
}

.feed-icon-time::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 2rpx;
  height: 8rpx;
  margin-left: -1rpx;
  background: var(--color-text-muted);
  border-radius: 1rpx;
}

.feed-icon-time::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 2rpx;
  margin-top: -1rpx;
  background: var(--color-text-muted);
  border-radius: 1rpx;
}

.feed-desc {
  font-size: var(--text-sm);
  line-height: var(--leading-relaxed);
  color: var(--color-text-muted);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.feed-footer {
  padding: var(--space-2) 0 var(--space-4);
  text-align: center;
}

.feed-footer-text {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
}

.fav-header {
  margin-bottom: var(--space-3);
}

.fav-header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-3);
  margin-bottom: 0;
}

.fav-back {
  font-size: var(--text-sm);
  color: var(--color-primary);
  font-weight: 600;
  line-height: var(--leading-normal);
}

.fav-title {
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.fav-placeholder {
  width: 120rpx;
}

<view class="container">
  <view class="card user-card" bindtap="showEditDialog">
    <image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" class="avatar" />
    <text wx:else class="avatar-placeholder">👤</text>
    <view class="user-text">
      <text class="nickname">{{userInfo.nickname || '未设置昵称'}}</text>
      <text class="edit-hint">点击编辑</text>
    </view>
  </view>

  <view class="card" bindtap="goAI">
    <view class="menu-item">🤖 AI 推荐菜谱</view>
  </view>

  <view class="card" bindtap="goFamily">
    <view class="menu-item">🏠 家庭管理</view>
  </view>

  <view class="card" bindtap="goFavorites">
    <view class="menu-item">❤️ 我的收藏</view>
  </view>

  <view class="card" bindtap="logout">
    <view class="menu-item" style="color: #F44336;">退出登录</view>
  </view>

  <!-- 编辑弹窗 -->
  <view wx:if="{{showEdit}}" class="modal-mask" bindtap="hideEditDialog">
    <view class="modal" catchtap>
      <view class="modal-title">编辑资料</view>
      <view class="form-group">
        <text class="label">昵称</text>
        <input value="{{editNickname}}" bindinput="onNicknameInput" placeholder="请输入昵称" />
      </view>
      <view class="form-group">
        <text class="label">头像</text>
        <view class="avatar-upload" bindtap="chooseAvatar">
          <image wx:if="{{editAvatar}}" src="{{editAvatar}}" class="avatar-preview" mode="aspectFill" />
          <text wx:else class="avatar-tip">📷 点击上传</text>
        </view>
        <text class="url-hint" wx:if="{{editAvatar}}">{{editAvatar}}</text>
      </view>
      <view class="modal-btns">
        <button class="btn-outline" bindtap="hideEditDialog">取消</button>
        <button class="btn-primary" bindtap="saveProfile">保存</button>
      </view>
    </view>
  </view>
</view>

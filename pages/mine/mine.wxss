.user-card { display: flex; align-items: center; gap: 24rpx; padding: 32rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; }
.avatar-placeholder { font-size: 60rpx; }
.user-text { flex: 1; }
.nickname { font-size: 34rpx; font-weight: bold; display: block; }
.edit-hint { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.menu-item { padding: 20rpx 0; font-size: 30rpx; }

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}
.modal-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 30rpx; }
.form-group { margin-bottom: 24rpx; }
.label { font-size: 26rpx; color: #666; margin-bottom: 10rpx; display: block; }
.form-group input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 40rpx;
}
.modal-btns { display: flex; gap: 20rpx; margin-top: 30rpx; }
.modal-btns button { flex: 1; margin: 0; }

/* 头像上传 */
.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: 0 auto;
}
.avatar-preview { width: 100%; height: 100%; }
.avatar-tip { font-size: 28rpx; color: #999; }
.url-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  word-break: break-all;
}

.user-card {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-3);
  margin-bottom: 0;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid var(--color-accent-soft);
  box-shadow: var(--shadow-surface);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-2xl);
  font-weight: 700;
  color: #fff;
  background: var(--color-primary);
}

.user-text {
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  display: block;
  color: var(--color-text);
}

.edit-hint {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
  display: block;
  line-height: var(--leading-normal);
}

.chef-card {
  padding: var(--space-3);
  margin-bottom: 0;
}

.chef-card .menu-item {
  padding: 0;
}

.chef-hint {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-2);
  display: block;
  line-height: var(--leading-relaxed);
}

.menu-row {
  padding: var(--space-1) var(--space-2);
  margin-bottom: 0;
}

.menu-row .menu-item {
  padding: var(--space-2) 0;
}

.logout-item {
  justify-content: center;
  color: var(--color-danger);
  font-weight: 600;
  padding: var(--space-2) 0 !important;
}

.container > .gradient-border {
  margin-bottom: var(--space-2);
}

.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: 0 auto;
  border: 3rpx dashed var(--color-border);
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-tip {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.oss-footer {
  margin-top: var(--space-4);
  padding: var(--space-3) var(--space-2) var(--space-6);
  text-align: center;
  transition: opacity var(--duration-fast) var(--ease-smooth);
}

.oss-footer-hover {
  opacity: 0.72;
}

.oss-footer-label {
  display: block;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: 6rpx;
}

.oss-footer-text {
  display: block;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-relaxed);
}

.oss-footer-link {
  display: block;
  margin-top: 6rpx;
  font-size: var(--text-xs);
  color: var(--color-primary);
  line-height: var(--leading-normal);
}

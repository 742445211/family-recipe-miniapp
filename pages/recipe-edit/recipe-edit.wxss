.form-group { margin-bottom: 30rpx; }
.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}
.form-group input, .form-group textarea, .picker-val {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 40rpx;
}
.difficulty-group { display: flex; gap: 16rpx; }
.diff-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 26rpx;
}
.diff-item.active { background: #FF6B35; color: #fff; }
.upload-area {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
}
.upload-area image { width: 100%; height: 100%; }
.ingredient-row, .step-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 12rpx;
}
.ingredient-row input { flex: 3; }
.ingredient-row input:last-child { flex: 2; }
.step-row textarea { flex: 1; }
.del { color: #F44336; font-size: 32rpx; padding: 10rpx; }
.step-num {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: #FF6B35;
  color: #fff;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
}
.add-btn { color: #FF6B35; padding: 16rpx; font-size: 26rpx; }
.container { padding-bottom: 60rpx; }

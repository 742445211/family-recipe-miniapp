.edit-page {
  padding-bottom: 60rpx;
}

.edit-page .gradient-border {
  margin-bottom: var(--space-2);
}

.edit-page .form-group {
  margin-bottom: var(--space-3);
}

.edit-page .form-group:last-child {
  margin-bottom: 0;
}

.edit-page input,
.edit-page textarea,
.picker-val {
  background: var(--color-surface);
  border-radius: var(--field-radius);
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-field);
  color: var(--color-text);
}

.difficulty-group {
  margin-top: 4rpx;
}

.upload-area {
  padding: 3rpx;
  display: inline-block;
}

.upload-inner {
  width: 220rpx;
  height: 220rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 0;
}

.upload-inner image {
  width: 100%;
  height: 100%;
}

.upload-tip {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  text-align: center;
  padding: var(--space-2);
  line-height: var(--leading-relaxed);
}

.ingredient-row,
.step-row {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  margin-bottom: var(--space-2);
}

.ingredient-row input {
  flex: 3;
}

.ingredient-row input:last-of-type {
  flex: 2;
}

.step-row textarea {
  flex: 1;
  min-height: 88rpx;
}

.del {
  color: var(--color-danger);
  font-size: var(--text-2xl);
  padding: 10rpx;
  line-height: 1;
}

.add-btn {
  color: var(--color-primary);
  padding: var(--space-2) 0;
  font-size: var(--text-sm);
  font-weight: 600;
  line-height: var(--leading-normal);
}

.submit-btn {
  margin-top: var(--space-2);
}

.catalog-block {
  margin-bottom: var(--space-3);
}

.catalog-btn {
  margin-bottom: var(--space-2);
}

.catalog-rate {
  display: block;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin-bottom: var(--space-2);
  text-align: center;
}

.variant-row {
  margin-bottom: var(--space-2);
}

.variant-trigger {
  width: 100%;
}

.variant-switch-hint {
  font-size: var(--text-xs);
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
  margin-right: var(--space-1);
}

.catalog-alt-btn {
  margin-bottom: var(--space-2);
}

.catalog-disclaimer {
  display: block;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  text-align: center;
}

.edit-page .select-trigger {
  width: 100%;
}

<view class="container edit-page">
  <view class="gradient-border">
    <view class="gradient-border-inner">
      <view class="form-group">
        <text class="label">菜名 *</text>
        <input value="{{name}}" bindinput="onInput" data-field="name" placeholder="给这道菜起个响亮的名字" />
      </view>

      <view class="form-group">
        <text class="label">分类</text>
        <picker bindchange="onCategory" value="{{categoryIndex}}" range="{{categories}}">
          <view class="picker-val">{{category || '选个分类'}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="label">难度</text>
        <view class="segment-bar difficulty-group">
          <view class="segment-item {{difficulty === 'easy' ? 'active' : ''}}" bindtap="setDifficulty" data-val="easy">简单</view>
          <view class="segment-item {{difficulty === 'medium' ? 'active' : ''}}" bindtap="setDifficulty" data-val="medium">中等</view>
          <view class="segment-item {{difficulty === 'hard' ? 'active' : ''}}" bindtap="setDifficulty" data-val="hard">困难</view>
        </view>
      </view>

      <view class="form-group">
        <text class="label">烹饪时长(分钟)</text>
        <input type="number" value="{{cookTime}}" bindinput="onInput" data-field="cookTime" placeholder="大概多久能出锅？" />
      </view>

      <view class="form-group">
        <text class="label">封面图</text>
        <view class="upload-area gradient-border" bindtap="chooseImage">
          <view class="gradient-border-inner upload-inner">
            <image wx:if="{{coverUrl}}" src="{{coverUrl}}" mode="aspectFill" lazy-load="{{true}}" />
            <text wx:else class="upload-tip">点我上传，馋哭邻居</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="gradient-border">
    <view class="gradient-border-inner">
      <view class="section-title">食材</view>
      <view wx:for="{{ingredients}}" wx:key="index" class="ingredient-row">
        <input value="{{item.name}}" data-idx="{{index}}" data-field="iname" bindinput="onIngredient" placeholder="食材名" />
        <input value="{{item.amount}}" data-idx="{{index}}" data-field="iamount" bindinput="onIngredient" placeholder="用量" />
        <text class="del" bindtap="delIngredient" data-idx="{{index}}">×</text>
      </view>
      <view class="add-btn" bindtap="addIngredient">+ 再加一种食材</view>
    </view>
  </view>

  <view class="gradient-border">
    <view class="gradient-border-inner">
      <view class="section-title">步骤</view>
      <view wx:for="{{steps}}" wx:key="index" class="step-row">
        <text class="step-num">{{index + 1}}</text>
        <textarea value="{{item}}" data-idx="{{index}}" bindinput="onStep" placeholder="这一步怎么做..." auto-height />
        <text class="del" bindtap="delStep" data-idx="{{index}}">×</text>
      </view>
      <view class="add-btn" bindtap="addStep">+ 再加一步</view>
    </view>
  </view>

  <view class="gradient-border">
    <view class="gradient-border-inner">
      <view class="section-title">小贴士</view>
      <textarea value="{{tips}}" bindinput="onInput" data-field="tips" placeholder="独门秘籍，Optional~" auto-height />
    </view>
  </view>

  <button class="btn-primary btn-block submit-btn" hover-class="btn-hover" bindtap="submit" loading="{{submitting}}">
    {{isEdit ? '保存修改' : '出锅！添加菜谱'}}
  </button>
</view>

.ai-header { text-align: center; padding: 40rpx; }
.ai-icon { font-size: 80rpx; display: block; }
.ai-title { font-size: 36rpx; font-weight: bold; display: block; margin: 16rpx 0; }
.ai-desc { color: #999; font-size: 26rpx; }

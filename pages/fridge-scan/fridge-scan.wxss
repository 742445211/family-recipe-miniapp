.scan-page {
  padding-bottom: var(--space-6);
  min-height: 100vh;
  box-sizing: border-box;
}

.preview-wrap {
  margin-bottom: var(--space-3);
}

.preview-inner {
  padding: 0;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  max-height: 360rpx;
  display: block;
  background: var(--color-surface-secondary);
}

.status-box {
  text-align: center;
  padding: var(--space-5) var(--space-3);
}

.status-title {
  display: block;
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.status-desc {
  display: block;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--space-4);
  line-height: var(--leading-relaxed);
}

.section-hint {
  display: block;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-3);
  line-height: var(--leading-normal);
}

.candidate-wrap {
  margin-bottom: var(--space-2);
}

.candidate-card {
  margin-bottom: 0;
}

.candidate-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.candidate-name {
  flex: 1;
  min-width: 0;
  background: var(--color-surface);
  border-radius: var(--field-radius);
  padding: var(--space-2);
  font-size: var(--text-base);
  box-shadow: var(--shadow-field);
  min-height: 72rpx;
  box-sizing: border-box;
}

.candidate-fields {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.candidate-fields input,
.picker-inline {
  flex: 1;
  background: var(--color-surface);
  border-radius: var(--field-radius);
  padding: var(--space-2);
  font-size: var(--text-sm);
  box-shadow: var(--shadow-field);
  min-height: 72rpx;
  box-sizing: border-box;
}

.candidate-note {
  width: 100%;
  background: var(--color-surface);
  border-radius: var(--field-radius);
  padding: var(--space-2);
  font-size: var(--text-sm);
  box-shadow: var(--shadow-field);
  min-height: 72rpx;
  box-sizing: border-box;
}

.confirm-btn {
  margin-top: var(--space-3);
}

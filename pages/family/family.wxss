.family-row { display: flex; justify-content: space-between; align-items: center; }
.family-name { font-size: 32rpx; font-weight: bold; display: block; }
.invite-code { color: #999; font-size: 24rpx; }
.switch-btn { color: #FF6B35; font-size: 24rpx; padding: 8rpx 20rpx; background: #FFF3E0; border-radius: 8rpx; }
.section { margin-top: 40rpx; }
.modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center;
}
.modal-content {
  background: #fff; border-radius: 16rpx; padding: 40rpx; width: 80%;
}
.modal-title { font-size: 34rpx; font-weight: bold; display: block; margin-bottom: 24rpx; }
.modal-content input { background: #f5f5f5; border-radius: 12rpx; padding: 20rpx; margin-bottom: 24rpx; }
.modal-btns { display: flex; gap: 20rpx; justify-content: flex-end; }

/* ===== 家庭菜谱 · 活泼食欲风设计系统 ===== */
page {
  /* 色彩 */
  --color-primary: #FF6B35;
  --color-primary-light: #FF8F5C;
  --color-primary-dark: #E85A24;
  --color-secondary: #FFB020;
  --color-accent: #FF4757;
  --color-fresh: #52C41A;
  --color-bg: #FFF8F0;
  --color-surface: #FFFFFF;
  --color-text: #2D1810;
  --color-text-secondary: #8B5E3C;
  --color-text-muted: #B8956A;
  --color-danger: #FF4757;
  --color-border: rgba(255, 107, 53, 0.15);

  /* 排版阶梯（8rpx 基准） */
  --text-xs: 22rpx;
  --text-sm: 24rpx;
  --text-base: 28rpx;
  --text-md: 30rpx;
  --text-lg: 32rpx;
  --text-xl: 36rpx;
  --text-2xl: 40rpx;
  --text-display: 48rpx;

  /* 行高 */
  --leading-tight: 1.3;
  --leading-normal: 1.5;
  --leading-relaxed: 1.65;

  /* 间距（4/8 递进） */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;

  /* 圆角 / 阴影 / 渐变 */
  --gradient-brand: linear-gradient(135deg, #FF6B35 0%, #FFB020 50%, #FF4757 100%);
  --gradient-warm: linear-gradient(135deg, #FFB020 0%, #FF6B35 100%);
  --gradient-soft: linear-gradient(180deg, #FFF8F0 0%, #FFE8D6 100%);
  --shadow-soft: 0 8rpx 32rpx rgba(255, 107, 53, 0.12);
  --shadow-card: 0 4rpx 20rpx rgba(45, 24, 16, 0.06);
  --shadow-float: 0 12rpx 40rpx rgba(255, 107, 53, 0.35);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-full: 999rpx;

  /* 悬浮按钮（Tab 页需避开底栏） */
  --fab-size: 112rpx;
  --tab-bar-height: 100rpx;
  --fab-offset-bottom: calc(var(--tab-bar-height) + var(--space-3) + env(safe-area-inset-bottom));
  --fab-scroll-padding: calc(var(--fab-size) + var(--fab-offset-bottom) + var(--space-3));

  background: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--color-text);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  letter-spacing: 0.02em;
}

.container {
  padding: var(--space-3);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 排版工具类 ===== */
.text-display {
  font-size: var(--text-display);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.text-title {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.text-headline {
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.text-body {
  font-size: var(--text-base);
  font-weight: 400;
  line-height: var(--leading-normal);
  color: var(--color-text);
}

.text-label {
  font-size: var(--text-sm);
  font-weight: 500;
  line-height: var(--leading-normal);
  color: var(--color-text-secondary);
}

.text-caption {
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--leading-normal);
  color: var(--color-text-muted);
}

.text-meta {
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
  color: var(--color-text-muted);
}

/* ===== 渐变边框卡片 ===== */
.gradient-border {
  padding: 3rpx;
  background: var(--gradient-brand);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}

.gradient-border-inner,
.card {
  background: var(--color-surface);
  border-radius: calc(var(--radius-lg) - 3rpx);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
  box-shadow: var(--shadow-card);
}

.gradient-border-inner.is-flush {
  margin-bottom: 0;
}

.card:last-child {
  margin-bottom: 0;
}

.card-plain {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
  box-shadow: var(--shadow-card);
}

/* ===== 按钮系统 ===== */
/* 小程序 button 需重置默认 margin / 伪元素边框 */
button.btn-primary,
button.btn-outline {
  margin: 0;
  min-height: 88rpx;
  height: auto;
  padding: 22rpx 32rpx !important;
  font-size: var(--text-md) !important;
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
  border-radius: var(--radius-full) !important;
  overflow: visible;
}

button.btn-primary::after,
button.btn-outline::after {
  border: none !important;
}

.btn-primary {
  background: var(--gradient-brand) !important;
  color: #fff !important;
  border: none !important;
  box-shadow: var(--shadow-soft);
}

.btn-outline {
  background: var(--color-surface) !important;
  color: var(--color-primary) !important;
  border: 3rpx solid var(--color-primary) !important;
  box-shadow: none;
}

/* 全宽主/次按钮 */
.btn-block {
  width: 100%;
  display: block;
}

/* view 模拟按钮（底栏等无法用原生 button 的场景） */
.btn-tap.btn-primary,
.btn-tap.btn-outline {
  margin: 0;
  min-height: 88rpx;
  padding: 22rpx 32rpx;
  font-size: var(--text-md);
  font-weight: 600;
  line-height: var(--leading-tight);
  box-sizing: border-box;
  border-radius: var(--radius-full);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-tap.btn-primary {
  background: var(--gradient-brand);
  color: #fff;
  box-shadow: var(--shadow-soft);
}

.btn-tap.btn-outline {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 3rpx solid var(--color-primary);
}

.btn-hover {
  opacity: 0.88;
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  margin-right: 10rpx;
  font-weight: 500;
}

.tag-category {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  color: var(--color-primary-dark);
}

.tag-easy {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #2E7D32;
}

.tag-medium {
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  color: #F57C00;
}

.tag-hard {
  background: linear-gradient(135deg, #FFEBEE, #FFCDD2);
  color: #C62828;
}

.tag-sm {
  padding: 4rpx 12rpx;
  font-size: var(--text-xs);
  margin-right: 6rpx;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: var(--space-6) var(--space-5);
  color: var(--color-text-muted);
  font-size: var(--text-base);
  line-height: var(--leading-relaxed);
}

.empty-title {
  display: block;
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
}

/* ===== 浮动按钮（渐变描边 + 白底，与点菜页卡片同系） ===== */
.float-btn-wrap {
  position: fixed;
  right: var(--space-3);
  bottom: var(--fab-offset-bottom);
  width: var(--fab-size);
  height: var(--fab-size);
  padding: 3rpx;
  border-radius: 50%;
  background: var(--gradient-brand);
  box-shadow: var(--shadow-float);
  z-index: 100;
  box-sizing: border-box;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.float-btn-wrap-hover {
  transform: scale(0.94);
  opacity: 0.96;
}

.float-btn {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
}

.float-btn-plus {
  font-size: 56rpx;
  font-weight: 400;
  color: var(--color-primary);
  line-height: 1;
  margin-top: -6rpx;
}

.page-with-fab {
  padding-bottom: var(--fab-scroll-padding) !important;
}

/* ===== 搜索框 ===== */
.search-input {
  flex: 1;
  background: var(--color-surface);
  border-radius: var(--radius-full);
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  box-shadow: var(--shadow-card);
  border: 2rpx solid var(--color-border);
  min-height: 80rpx;
  box-sizing: border-box;
}

/* ===== 分段选择器 ===== */
.segment-bar {
  display: flex;
  background: rgba(255, 107, 53, 0.08);
  border-radius: var(--radius-full);
  padding: 6rpx;
  gap: 6rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: var(--space-2) 0;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
  line-height: var(--leading-normal);
  transition: all 0.2s ease;
}

.segment-item.active {
  background: var(--gradient-brand);
  color: #fff;
  box-shadow: var(--shadow-soft);
}

/* ===== 视图切换 ===== */
.view-toggle {
  display: flex;
  gap: 8rpx;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 6rpx;
  box-shadow: var(--shadow-card);
  border: 2rpx solid var(--color-border);
}

.view-toggle-item {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: 32rpx;
  color: var(--color-text-muted);
}

.view-toggle-item.active {
  background: var(--gradient-warm);
  color: #fff;
}

/* ===== 菜单项 ===== */
.menu-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) 0;
  font-size: var(--text-md);
  font-weight: 500;
  line-height: var(--leading-normal);
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-sm);
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.menu-icon-ai { background: linear-gradient(135deg, #667eea, #764ba2); }
.menu-icon-family { background: var(--gradient-warm); }
.menu-icon-fav { background: linear-gradient(135deg, #FF4757, #FF6B35); }
.menu-icon-notify { background: linear-gradient(135deg, #FFB020, #FF8F5C); }
.menu-icon-chef { background: linear-gradient(135deg, #52C41A, #73D13D); }

.menu-arrow {
  margin-left: auto;
  color: var(--color-text-muted);
  font-size: 36rpx;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 24, 16, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 620rpx;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  box-shadow: 0 24rpx 80rpx rgba(45, 24, 16, 0.2);
  border: 3rpx solid transparent;
  background-clip: padding-box;
  position: relative;
}

.modal::before {
  content: '';
  position: absolute;
  inset: -3rpx;
  border-radius: var(--radius-xl);
  background: var(--gradient-brand);
  z-index: -1;
}

.modal-title {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  text-align: center;
  margin-bottom: var(--space-4);
  color: var(--color-text);
}

.form-group {
  margin-bottom: var(--space-3);
}

.label {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-1);
  display: block;
  font-weight: 500;
  line-height: var(--leading-normal);
}

.form-group input,
.form-group textarea,
.picker-text,
.picker-val {
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-base);
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  line-height: var(--leading-normal);
  border: 2rpx solid var(--color-border);
  color: var(--color-text);
}

.modal-btns {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-4);
  align-items: stretch;
}

.modal-btns button,
.modal-btns .btn-tap {
  flex: 1;
  margin: 0 !important;
  min-width: 0;
}

.bottom-bar {
  display: flex;
  gap: var(--space-2);
  align-items: stretch;
}

.bottom-bar button,
.bottom-bar .btn-tap {
  flex: 1;
  margin: 0 !important;
  min-width: 0;
}

/* ===== 区块标题 ===== */
.section-title {
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  margin-bottom: var(--space-2);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: var(--gradient-brand);
  border-radius: 4rpx;
  flex-shrink: 0;
}

/* ===== 步骤序号 ===== */
.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--gradient-brand);
  color: #fff;
  text-align: center;
  line-height: 48rpx;
  font-size: var(--text-sm);
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: var(--shadow-soft);
}

/* ===== 家庭菜谱 · HeroUI v3 + shadcn 适配设计系统（微信 WXSS） ===== */
page {
  /* 品牌色 */
  --color-primary: #FF6B35;
  --color-primary-light: #FF8F5C;
  --color-primary-dark: #E85A24;
  --color-secondary: #FFB020;
  --color-accent: #FF4757;
  --color-fresh: #52C41A;
  --color-danger: #FF4757;

  /* HeroUI surface / shadcn muted 语义色 */
  --color-bg: #FFF8F0;
  --color-surface: #FFFFFF;
  --color-surface-secondary: #F5F0EB;
  --color-surface-tertiary: #EDE6DE;
  --color-default: #F0EBE6;
  --color-text: #2D1810;
  --color-text-secondary: #8B5E3C;
  --color-text-muted: #B8956A;
  --color-border: rgba(45, 24, 16, 0.08);
  --color-border-strong: rgba(45, 24, 16, 0.12);
  --color-border-subtle: rgba(45, 24, 16, 0.06);
  --color-muted: #B8956A;
  --color-accent-soft: rgba(255, 107, 53, 0.14);
  --color-success-soft: rgba(82, 196, 26, 0.14);
  --color-warning-soft: rgba(255, 176, 32, 0.18);
  --color-danger-soft: rgba(255, 71, 87, 0.12);

  /* 排版阶梯（8rpx 基准） */
  --text-xs: 22rpx;
  --text-sm: 24rpx;
  --text-base: 28rpx;
  --text-md: 30rpx;
  --text-lg: 32rpx;
  --text-xl: 36rpx;
  --text-2xl: 40rpx;
  --text-display: 48rpx;

  /* 行高 */
  --leading-tight: 1.3;
  --leading-normal: 1.5;
  --leading-relaxed: 1.65;

  /* 间距（4/8 递进） */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;

  /* 圆角 / 阴影 / 渐变 */
  /* 描边线框：多段暖色过渡，细边不易断层；与按钮渐变分离 */
  --gradient-border: linear-gradient(
    145deg,
    #FF6B35 0%,
    #FF9848 20%,
    #FFB84D 45%,
    #FF9A56 72%,
    #FF7A45 100%
  );
  --gradient-brand: linear-gradient(135deg, #FF6B35 0%, #FFB020 38%, #FF5E4D 100%);
  --gradient-warm: linear-gradient(135deg, #FFB84D 0%, #FF6B35 100%);
  --gradient-soft: linear-gradient(180deg, #FFF8F0 0%, #FFE8D6 100%);
  /* HeroUI surface-shadow / shadcn shadow-sm */
  --shadow-surface: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.06), 0 0 2rpx rgba(0, 0, 0, 0.04);
  --shadow-field: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.06), 0 0 2rpx rgba(0, 0, 0, 0.04);
  --shadow-soft: 0 8rpx 32rpx rgba(255, 107, 53, 0.12);
  --shadow-card: var(--shadow-surface);
  --shadow-overlay: 0 8rpx 24rpx rgba(0, 0, 0, 0.06), 0 -6rpx 24rpx rgba(0, 0, 0, 0.03), 0 28rpx 56rpx rgba(0, 0, 0, 0.08);
  /* shadcn shadow-lg + 品牌色光晕，FAB 浮于 Tab 之上 */
  --shadow-float: 0 16rpx 40rpx rgba(255, 107, 53, 0.32), 0 6rpx 16rpx rgba(45, 24, 16, 0.1), 0 0 0 2rpx rgba(255, 255, 255, 0.45);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-card: 32rpx;
  --radius-xl: 36rpx;
  --radius-full: 999rpx;
  --field-radius: 24rpx;
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-out: cubic-bezier(0, 0, 0.2, 1);
  --duration-fast: 150ms;
  --duration-normal: 250ms;

  /* 悬浮按钮（Tab 页需避开底栏） */
  --fab-size: 112rpx;
  --tab-bar-height: 100rpx;
  --fab-offset-bottom: calc(var(--tab-bar-height) + var(--space-3) + env(safe-area-inset-bottom));
  --fab-scroll-padding: calc(var(--fab-size) + var(--fab-offset-bottom) + var(--space-3));

  background: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--color-text);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  letter-spacing: 0.02em;
}

.container {
  padding: var(--space-3);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 排版工具类 ===== */
.text-display {
  font-size: var(--text-display);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.text-title {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.text-headline {
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.text-body {
  font-size: var(--text-base);
  font-weight: 400;
  line-height: var(--leading-normal);
  color: var(--color-text);
}

.text-label {
  font-size: var(--text-sm);
  font-weight: 500;
  line-height: var(--leading-normal);
  color: var(--color-text-secondary);
}

.text-caption {
  font-size: var(--text-xs);
  font-weight: 400;
  line-height: var(--leading-normal);
  color: var(--color-text-muted);
}

.text-meta {
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
  color: var(--color-text-muted);
}

/* ===== 卡片（HeroUI Card / shadcn Card 语义） ===== */
.gradient-border {
  padding: 2rpx;
  background: var(--gradient-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-surface);
  overflow: hidden;
}

.gradient-border-inner,
.card {
  background: var(--color-surface);
  border-radius: calc(var(--radius-card) - 2rpx);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
  box-shadow: none;
}

.gradient-border-inner.is-flush {
  margin-bottom: 0;
}

.card:last-child {
  margin-bottom: 0;
}

.card-plain {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
  box-shadow: var(--shadow-surface);
  border: 2rpx solid var(--color-border-subtle);
}

/* ===== 按钮系统 ===== */
/* 小程序 button 需重置默认 margin / 伪元素边框 */
button.btn-primary,
button.btn-outline {
  margin: 0;
  min-height: 88rpx;
  height: auto;
  padding: 22rpx 32rpx !important;
  font-size: var(--text-md) !important;
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
  border-radius: var(--radius-full) !important;
  overflow: visible;
}

button.btn-primary::after,
button.btn-outline::after {
  border: none !important;
}

.btn-primary {
  background: var(--color-primary) !important;
  color: #fff !important;
  border: none !important;
  box-shadow: var(--shadow-soft);
  transition: transform var(--duration-normal) var(--ease-smooth), background-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
}

.btn-outline {
  background: var(--color-surface) !important;
  color: var(--color-primary) !important;
  border: 2rpx solid var(--color-border-strong) !important;
  box-shadow: var(--shadow-field);
  transition: transform var(--duration-normal) var(--ease-smooth), background-color var(--duration-fast) var(--ease-out);
}

/* 全宽主/次按钮 */
.btn-block {
  width: 100%;
  display: block;
}

/* view 模拟按钮（底栏等无法用原生 button 的场景） */
.btn-tap.btn-primary,
.btn-tap.btn-outline {
  margin: 0;
  min-height: 88rpx;
  padding: 22rpx 32rpx;
  font-size: var(--text-md);
  font-weight: 600;
  line-height: var(--leading-tight);
  box-sizing: border-box;
  border-radius: var(--radius-full);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-tap.btn-primary {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-soft);
  transition: transform var(--duration-normal) var(--ease-smooth);
}

.btn-tap.btn-outline {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2rpx solid var(--color-border-strong);
  box-shadow: var(--shadow-field);
  transition: transform var(--duration-normal) var(--ease-smooth);
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.96;
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  margin-right: 10rpx;
  font-weight: 500;
}

/* HeroUI Chip soft 变体 */
.tag-category {
  background: var(--color-warning-soft);
  color: var(--color-primary-dark);
}

.tag-easy {
  background: var(--color-success-soft);
  color: #2E7D32;
}

.tag-medium {
  background: var(--color-warning-soft);
  color: #E85A24;
}

.tag-hard {
  background: var(--color-danger-soft);
  color: #C62828;
}

.tag-sm {
  padding: 4rpx 12rpx;
  font-size: var(--text-xs);
  margin-right: 6rpx;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: var(--space-6) var(--space-5);
  color: var(--color-text-muted);
  font-size: var(--text-base);
  line-height: var(--leading-relaxed);
}

.empty-title {
  display: block;
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
}

/* ===== 浮动按钮（HeroUI button--icon-only + shadcn size-icon） ===== */
.float-btn-wrap {
  position: fixed;
  right: var(--space-3);
  bottom: var(--fab-offset-bottom);
  width: var(--fab-size);
  height: var(--fab-size);
  padding: 0;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: var(--shadow-float);
  z-index: 100;
  box-sizing: border-box;
  isolation: isolate;
  transition:
    transform var(--duration-normal) var(--ease-smooth),
    background-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

/* 顶部高光（HeroUI surface 质感） */
.float-btn-wrap::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, transparent 52%);
  pointer-events: none;
  z-index: 0;
}

.float-btn-wrap-hover {
  transform: scale(0.97);
  background: var(--color-primary-dark);
}

.float-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Lucide Plus 风格矢量加号（替代文本 +，避免字号偏移） */
.float-btn-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  flex-shrink: 0;
}

.float-btn-icon::before,
.float-btn-icon::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: var(--radius-full);
}

.float-btn-icon::before {
  left: 0;
  right: 0;
  top: 50%;
  height: 4rpx;
  margin-top: -2rpx;
}

.float-btn-icon::after {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 4rpx;
  margin-left: -2rpx;
}

.page-with-fab {
  padding-bottom: var(--fab-scroll-padding) !important;
}

/* ===== 搜索框（HeroUI Input / shadcn field） ===== */
.search-input {
  flex: 1;
  background: var(--color-surface);
  border-radius: var(--field-radius);
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  box-shadow: var(--shadow-field);
  border: 2rpx solid transparent;
  min-height: 80rpx;
  box-sizing: border-box;
  color: var(--color-text);
  transition: border-color var(--duration-fast) var(--ease-smooth), box-shadow var(--duration-fast) var(--ease-out);
}

/* ===== 分段选择器（HeroUI Tabs segment） ===== */
.segment-bar {
  display: flex;
  background: var(--color-default);
  border-radius: calc(var(--radius-md) * 2.5);
  padding: 6rpx;
  gap: 6rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: var(--space-2) 0;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--color-muted);
  font-weight: 500;
  line-height: var(--leading-normal);
  transition: color var(--duration-fast) var(--ease-smooth), background-color var(--duration-fast) var(--ease-smooth), box-shadow var(--duration-fast) var(--ease-out);
}

.segment-item.active {
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: var(--shadow-surface);
}

/* ===== 视图切换（HeroUI Tabs 指示器风格） ===== */
.view-toggle {
  display: flex;
  gap: 6rpx;
  background: var(--color-default);
  border-radius: calc(var(--radius-md) * 2.5);
  padding: 6rpx;
  box-shadow: none;
  border: none;
}

.view-toggle-item {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: 32rpx;
  color: var(--color-muted);
  transition: color var(--duration-fast) var(--ease-smooth), background-color var(--duration-fast) var(--ease-smooth), box-shadow var(--duration-fast) var(--ease-out);
}

.view-toggle-item.active {
  background: var(--color-surface);
  color: var(--color-primary);
  box-shadow: var(--shadow-surface);
}

/* ===== 菜单项 ===== */
.menu-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) 0;
  font-size: var(--text-md);
  font-weight: 500;
  line-height: var(--leading-normal);
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-sm);
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.menu-icon-ai { background: #6B7AE8; }
.menu-icon-family { background: var(--color-primary); }
.menu-icon-fav { background: var(--color-accent); }
.menu-icon-notify { background: var(--color-secondary); }
.menu-icon-chef { background: var(--color-fresh); }

.menu-arrow {
  margin-left: auto;
  color: var(--color-text-muted);
  font-size: 36rpx;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 620rpx;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  box-shadow: var(--shadow-overlay);
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

.modal-title {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  text-align: center;
  margin-bottom: var(--space-4);
  color: var(--color-text);
}

.form-group {
  margin-bottom: var(--space-3);
}

.label {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-1);
  display: block;
  font-weight: 500;
  line-height: var(--leading-normal);
}

.form-group input,
.form-group textarea,
.picker-text,
.picker-val {
  background: var(--color-surface);
  border-radius: var(--field-radius);
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-base);
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  line-height: var(--leading-normal);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-field);
  color: var(--color-text);
}

/* ===== 自定义下拉触发器（替代原生 picker） ===== */
.select-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  background: var(--color-surface);
  border-radius: var(--field-radius);
  padding: var(--space-2) var(--space-3);
  min-height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-field);
  transition: border-color var(--duration-fast) var(--ease-smooth), box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-normal) var(--ease-smooth);
}

.select-trigger-hover {
  border-color: var(--color-border-strong);
  box-shadow: var(--shadow-surface);
}

.select-trigger-text {
  flex: 1;
  min-width: 0;
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  color: var(--color-text);
  font-weight: 500;
}

.select-trigger-placeholder {
  color: var(--color-text-muted);
  font-weight: 400;
}

.select-trigger-chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--color-text-muted);
  border-bottom: 3rpx solid var(--color-text-muted);
  transform: rotate(45deg);
  margin-top: -6rpx;
  flex-shrink: 0;
  transition: transform var(--duration-fast) var(--ease-smooth);
}

.select-trigger.is-open .select-trigger-chevron {
  transform: rotate(-135deg);
  margin-top: 6rpx;
}

.modal-btns {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-4);
  align-items: stretch;
}

.modal-btns button,
.modal-btns .btn-tap {
  flex: 1;
  margin: 0 !important;
  min-width: 0;
}

.bottom-bar {
  display: flex;
  gap: var(--space-2);
  align-items: stretch;
}

.bottom-bar button,
.bottom-bar .btn-tap {
  flex: 1;
  margin: 0 !important;
  min-width: 0;
}

/* ===== 区块标题 ===== */
.section-title {
  font-size: var(--text-lg);
  font-weight: 700;
  line-height: var(--leading-tight);
  margin-bottom: var(--space-2);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: var(--color-primary);
  border-radius: 4rpx;
  flex-shrink: 0;
}

/* ===== 步骤序号 ===== */
.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  text-align: center;
  line-height: 48rpx;
  font-size: var(--text-sm);
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: var(--shadow-soft);
}

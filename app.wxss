page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.btn-primary {
  background: #FF6B35;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 16rpx 0;
}

.btn-outline {
  border: 2rpx solid #FF6B35;
  color: #FF6B35;
  background: transparent;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 12rpx 0;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-category { background: #FFF3E0; color: #FF6B35; }
.tag-easy { background: #E8F5E9; color: #4CAF50; }
.tag-medium { background: #FFF8E1; color: #FF9800; }
.tag-hard { background: #FFEBEE; color: #F44336; }

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.float-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FF6B35;
  color: #fff;
  font-size: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.4);
}
